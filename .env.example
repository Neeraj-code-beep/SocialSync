# ============================================================
# SocialSync Environment Variables (.env.example)
# Copy this file to .env and provide your actual credentials
# ============================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Connection String)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/socialsync?retryWrites=true&w=majority

# Authentication Security (Must be a strong, random key)
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_here

# Google Gemini AI Vision API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ImageKit CDN Storage Credentials
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# LinkedIn OAuth 2.0 & Posts REST API Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/social/linkedin/callback
LINKEDIN_API_VERSION=202608

# Social Sync Token Encryption Secret (Minimum 32 characters for AES-256-GCM)
SOCIAL_TOKEN_ENCRYPTION_KEY=your_secure_random_32_plus_char_encryption_key_here

# Frontend Vite API Proxy / Endpoint
VITE_API_URL=http://localhost:4000/api
